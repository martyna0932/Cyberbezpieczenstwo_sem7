{
  "name": "auth-app",
  "version": "0.7.0",
  "description": "Identyfikacja, uwierzytelnianie i autoryzacja oraz zabezpieczenia przed botami (wariant 6)",
  "main": "src/app.js",
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env src/app.js",
    "dev": "node --env-file-if-exists=.env --watch src/app.js",
    "seed": "node src/db/seed.js",
    "reset-db": "node src/db/seed.js --reset",
    "setting": "node src/db/set-setting.js"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "better-sqlite3": "^11.7.0",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4"
  }
}
