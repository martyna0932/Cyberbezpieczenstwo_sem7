<%- include('partials/header') %>
<section class="card narrow">
  <h1>Zmiana hasła</h1>

  <% if (notice) { %>
    <p class="alert alert-info"><%= notice %></p>
  <% } %>
  <% errors.forEach((error) => { %>
    <p class="alert alert-error"><%= error %></p>
  <% }) %>

  <form method="post" action="/change-password" class="form" id="password-form"
        data-min-length="<%= policy.minLength %>"
        data-max-length="<%= policy.maxLength %>"
        data-passphrase="<%= policy.passphraseRule ? 1 : 0 %>"
        data-min-words="<%= policy.minWords %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <label for="currentPassword">Obecne hasło</label>
    <input id="currentPassword" name="currentPassword" type="password" required autocomplete="current-password">

    <label for="newPassword">Nowe hasło</label>
    <input id="newPassword" name="newPassword" type="password" required autocomplete="new-password">

    <label for="confirmPassword">Powtórz nowe hasło</label>
    <input id="confirmPassword" name="confirmPassword" type="password" required autocomplete="new-password">

    <ul class="checklist">
      <li data-rule="length">Co najmniej <%= policy.minLength %> znaków</li>
      <% if (policy.passphraseRule) { %>
        <li data-rule="words">Co najmniej <%= policy.minWords %> słowa oddzielone spacją lub myślnikiem</li>
      <% } %>
      <li data-rule="match">Oba nowe hasła są takie same</li>
      <li>Inne niż obecne i <%= historyCount %> poprzednich haseł</li>
    </ul>

    <button type="submit" class="btn btn-primary">Zmień hasło</button>
  </form>
</section>
<script src="/js/password-check.js" defer></script>
<%- include('partials/footer') %>
