<%- include('partials/header') %>
<h1>Witaj, <%= currentUser.fullName %></h1>

<section class="card">
  <dl class="details">
    <dt>Login</dt>
    <dd><%= currentUser.login %></dd>
    <dt>Role</dt>
    <dd><%= currentUser.roles.join(', ') %></dd>
    <dt>Weryfikacja dwuetapowa</dt>
    <dd>
      <%= currentUser.totpEnabled ? 'włączona' : 'wyłączona' %>
      (<a href="/account/2fa"><%= currentUser.totpEnabled ? 'zarządzaj' : 'włącz' %></a>)
    </dd>
  </dl>

  <h3>Uprawnienia</h3>
  <ul class="perm-list">
    <% currentUser.permissions.forEach((code) => { %>
      <li><code><%= code %></code></li>
    <% }) %>
  </ul>
</section>
<%- include('partials/footer') %>
