<%- include('partials/header') %>
<section class="card narrow">
  <h1>Logowanie</h1>

  <% if (info) { %>
    <p class="alert alert-info"><%= info %></p>
  <% } %>
  <% if (locals.lockSeconds) { %>
    <p class="alert alert-error" id="lock-info" data-seconds="<%= lockSeconds %>">
      Zbyt wiele nieudanych prób logowania. Konto zostało zablokowane na 15 minut.
      Spróbuj ponownie za <strong id="lock-timer"><%= Math.floor(lockSeconds / 60) %>:<%= String(lockSeconds % 60).padStart(2, '0') %></strong>.
    </p>
  <% } else if (error) { %>
    <p class="alert alert-error"><%= error %></p>
  <% } %>

  <form method="post" action="/login" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <label for="login">Login</label>
    <input id="login" name="login" type="text" value="<%= login %>" required maxlength="64" autocomplete="username" autofocus>

    <label for="password">Hasło</label>
    <input id="password" name="password" type="password" required autocomplete="current-password">

    <%- include('partials/turnstile') %>

    <button type="submit" class="btn btn-primary">Zaloguj</button>
  </form>
</section>
<script src="/js/lock-timer.js" defer></script>
<%- include('partials/footer') %>
