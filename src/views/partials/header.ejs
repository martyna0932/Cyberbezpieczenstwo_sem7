<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | System dokumentów</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/session-timer.js" defer></script>
</head>
<body data-idle-seconds="<%= locals.sessionIdleSeconds || '' %>">
  <header class="topbar">
    <a href="/" class="brand">System dokumentów</a>
    <% if (locals.currentUser) { %>
      <div class="userbar">
        <span id="session-timer" class="session-timer"></span>
        <span><%= currentUser.fullName %> <span class="muted">(<%= currentUser.roles.join(', ') %>)</span></span>
        <% if (currentUser.permissions.includes('documents.read')) { %>
          <a href="/documents">Dokumenty</a>
        <% } %>
        <% if (currentUser.permissions.includes('users.manage')) { %>
          <a href="/admin/users">Panel administratora</a>
        <% } %>
        <% if (locals.unreadAlerts !== undefined) { %>
          <a href="/admin/alerts" class="alert-bell" title="Alerty bezpieczeństwa">&#128276;<% if (unreadAlerts > 0) { %><span class="alert-count"><%= unreadAlerts %></span><% } %></a>
        <% } %>
        <a href="/change-password">Zmień hasło</a>
        <form method="post" action="/logout" class="inline">
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
          <button type="submit" class="btn btn-secondary">Wyloguj</button>
        </form>
      </div>
    <% } %>
  </header>
  <main class="container">
    <% if (locals.unreadAlerts > 0) { %>
      <p class="alert alert-error">
        Masz nowe alerty bezpieczeństwa (<%= unreadAlerts %>). <a href="/admin/alerts">Zobacz alerty</a>
      </p>
    <% } %>
    <% if (locals.flash) { %>
      <p class="alert alert-success"><%= flash %></p>
    <% } %>
