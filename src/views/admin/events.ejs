<%- include('../partials/header') %>
<h1>Panel administratora</h1>
<%- include('nav', { active: 'events' }) %>

<form method="get" action="/admin/events" class="toolbar filter">
  <label for="type">Typ zdarzenia</label>
  <select id="type" name="type">
    <option value="">wszystkie</option>
    <% types.forEach((t) => { %>
      <option value="<%= t %>" <%= t === type ? 'selected' : '' %>><%= t %></option>
    <% }) %>
  </select>
  <button type="submit" class="btn btn-small btn-secondary">Pokaż</button>
</form>

<div class="table-wrap">
  <table class="table">
    <thead>
      <tr>
        <th>Czas</th>
        <th>Zdarzenie</th>
        <th>Użytkownik</th>
        <th>Opis</th>
        <th>Wynik</th>
        <th>IP</th>
      </tr>
    </thead>
    <tbody>
      <% if (events.length === 0) { %>
        <tr><td colspan="6">Brak zdarzeń.</td></tr>
      <% } %>
      <% events.forEach((e) => { %>
        <tr>
          <td title="<%= e.time %>"><%= new Date(e.time).toLocaleString('pl-PL') %></td>
          <td><span class="badge <%= e.result === 'BŁĄD' ? 'badge-danger' : 'badge-ok' %>"><%= e.action %></span></td>
          <td><%= e.user %></td>
          <td><%= e.desc %></td>
          <td><%= e.result %></td>
          <td><%= e.ip %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<p class="muted">Wyświetlane jest ostatnie 200 zdarzeń z pliku data/security.log. Czas zapisywany jest w UTC i wyświetlany w czasie lokalnym.</p>
<%- include('../partials/footer') %>
