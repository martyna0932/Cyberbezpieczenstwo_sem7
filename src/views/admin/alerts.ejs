<%- include('../partials/header') %>
<h1>Panel administratora</h1>
<%- include('nav', { active: 'alerts' }) %>

<form method="post" action="/admin/alerts/read-all" class="toolbar">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <button type="submit" class="btn btn-small btn-secondary">Oznacz wszystkie jako przeczytane</button>
</form>

<div class="table-wrap">
  <table class="table">
    <thead>
      <tr>
        <th>Czas</th>
        <th>Alert</th>
        <th>Konto</th>
        <th>Opis</th>
        <th>IP</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% if (notifications.length === 0) { %>
        <tr><td colspan="6">Brak alertów.</td></tr>
      <% } %>
      <% notifications.forEach((n) => { %>
        <tr class="<%= n.read_at ? '' : 'unread' %>">
          <td><%= new Date(n.created_at).toLocaleString('pl-PL') %></td>
          <td><span class="badge badge-danger"><%= n.title %></span></td>
          <td><%= n.login %></td>
          <td class="wrap"><%= n.message %></td>
          <td><%= n.ip || '' %></td>
          <td>
            <% if (n.read_at) { %>
              <span class="muted">przeczytany</span>
            <% } else { %>
              <form method="post" action="/admin/alerts/<%= n.id %>/read" class="inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-small btn-secondary">Oznacz jako przeczytany</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
