<%- include('../partials/header') %>
<h1>Dokumenty</h1>

<% if (currentUser.permissions.includes('documents.create')) { %>
  <div class="toolbar">
    <a href="/documents/new" class="btn btn-primary">Nowy dokument</a>
  </div>
<% } %>

<% if (documents.length === 0) { %>
  <p class="muted">Brak dokumentów.</p>
<% } else { %>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>Tytuł</th>
          <th>Autor</th>
          <th>Status</th>
          <th>Ostatnia zmiana</th>
          <th>Akcje</th>
        </tr>
      </thead>
      <tbody>
        <% documents.forEach((doc) => { %>
          <tr>
            <td><a href="/documents/<%= doc.id %>"><%= doc.title %></a></td>
            <td><%= doc.author_name || '-' %></td>
            <td>
              <% if (doc.status === 'published') { %>
                <span class="badge badge-ok">opublikowany</span>
              <% } else { %>
                <span class="badge badge-warn">szkic</span>
              <% } %>
            </td>
            <td><%= doc.updated_at %></td>
            <td class="actions">
              <a href="/documents/<%= doc.id %>" class="btn btn-small btn-secondary">Otwórz</a>
              <% if (canEdit(doc)) { %>
                <a href="/documents/<%= doc.id %>/edit" class="btn btn-small btn-secondary">Edytuj</a>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
<%- include('../partials/footer') %>
